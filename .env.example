# Appwrite Configuration for Docker Deployment
# Copy this file to .env and fill in your Appwrite credentials
# Docker Compose will read these variables and pass them to the container

# Your Appwrite endpoint (e.g., https://cloud.appwrite.io/v1)
NEXT_PUBLIC_APPWRITE_ENDPOINT=

# Your Appwrite project ID
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Your Appwrite API Key (Server-side only, keep secret!)
APPWRITE_API_KEY=

# Your Appwrite database ID
NEXT_PUBLIC_APPWRITE_DATABASE_ID=

# Your Appwrite waitlist collection ID
NEXT_PUBLIC_APPWRITE_WAITLIST_COLLECTION_ID=
